#!/bin/bash
# VD · 飞牛原生应用生命周期脚本（不使用 Docker）
set -u

PKG_VAR="${TRIM_PKGVAR:-/var/apps/vd/var}"
APP_DIR="${TRIM_APPDEST:-/var/apps/vd/target}"
PY="${FNOS_PYTHON:-/var/apps/python312/target/bin/python3}"
PORT="${wizard_port:-8000}"
DATA_DIR="${wizard_data_dir:-/var/apps/vd/var/data}"
DL_DIR="${wizard_download_dir:-/vol1/1000/下载/视频下载}"
PID_FILE="${PKG_VAR}/app.pid"
LOG_FILE="${PKG_VAR}/app.log"

log() { printf '%s - %s\n' "$(date '+%F %T')" "$1" >> "${LOG_FILE}" 2>/dev/null || true; }
fail() {
    printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null || true
    log "失败: $1"
    exit 1
}

pid_running() {
    [ -f "${PID_FILE}" ] || return 1
    local p
    p="$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    [ -n "${p}" ] && kill -0 "${p}" 2>/dev/null
}

port_ready() { curl -fsS -o /dev/null --max-time 3 "http://127.0.0.1:${PORT}/api/%E5%81%A5%E5%BA%B7%E6%A3%80%E6%9F%A5" 2>/dev/null; }

port_in_use() {
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${PORT}$"
        return $?
    fi
    local hex
    hex="$(printf '%04X' "${PORT}")"
    awk 'NR>1 {print $2}' /proc/net/tcp /proc/net/tcp6 2>/dev/null | grep -qiE ":${hex}$"
}

start_app() {
    [ -x "${PY}" ] || fail "未找到飞牛 Python 运行时 ${PY}，请先在应用中心安装 python312。"
    [ -f "${APP_DIR}/server/app/main.py" ] || fail "应用文件不完整，请重新安装。"
    command -v ffmpeg >/dev/null 2>&1 || log "警告：系统未找到 ffmpeg，音视频合并将失败"
    pid_running && return 0
    if port_in_use; then
        fail "端口 ${PORT} 已被其它程序占用（可能是旧的 Docker 版 VD），请先停止它，或在「应用设置」里换一个端口。"
    fi

    mkdir -p "${DATA_DIR}" "${DL_DIR}" "${PKG_VAR}" 2>/dev/null || true
    log "启动: 端口 ${PORT}，下载目录 ${DL_DIR}，数据目录 ${DATA_DIR}"
    (
        cd "${APP_DIR}/server" || exit 1
        # pylib-override 放用户在界面里一键更新的 yt-dlp，优先级最高
        DATA_DIR="${DATA_DIR}" DOWNLOAD_DIR="${DL_DIR}" \
        PYTHONPATH="${DATA_DIR}/pylib-override:${APP_DIR}/server:${APP_DIR}/pylib" \
        PYTHONUNBUFFERED=1 TZ="${TZ:-Asia/Shanghai}" \
        nohup "${PY}" -m uvicorn app.main:app --host 0.0.0.0 --port "${PORT}" --no-access-log \
            >>"${LOG_FILE}" 2>&1 &
        echo $! > "${PID_FILE}"
    )

    for _ in $(seq 1 45); do
        if ! pid_running; then
            tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null || true
            fail "进程启动后立即退出，请查看 ${LOG_FILE}"
        fi
        if port_ready; then
            log "启动成功"
            return 0
        fi
        sleep 1
    done
    tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null || true
    fail "启动超时（45 秒内端口 ${PORT} 未就绪）"
}

stop_app() {
    if ! pid_running; then
        rm -f "${PID_FILE}"
        return 0
    fi
    local p
    p="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    log "停止进程 ${p}"
    kill "${p}" 2>/dev/null || true
    for _ in $(seq 1 20); do
        kill -0 "${p}" 2>/dev/null || break
        sleep 1
    done
    kill -0 "${p}" 2>/dev/null && kill -9 "${p}" 2>/dev/null
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
    start) start_app ;;
    stop) stop_app ;;
    status) if pid_running && port_ready; then exit 0; else exit 3; fi ;;
    *) exit 1 ;;
esac
